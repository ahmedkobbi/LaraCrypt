{
    "name": "laracrypt/engine",
    "description": "LaraCrypt obfuscation engine — AST-based, semantics-preserving PHP source protection (Layers 0–1).",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "nikic/php-parser": "^5.3",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": { "LaraCrypt\\Engine\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "LaraCrypt\\Engine\\Tests\\": "tests/" }
    },
    "bin": ["bin/laracrypt"],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
